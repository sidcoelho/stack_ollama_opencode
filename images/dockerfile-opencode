FROM ghcr.io/astral-sh/uv:python3.15-alpine3.23

ENV TZ=America/Sao_Paulo

# Dependências: curl e bash para o instalador; libgcc/libstdc++ para o binário em musl
RUN apk add --no-cache \
    bash \
    curl \
    ca-certificates \
    tzdata \
    libgcc \
    libstdc++ \
    poppler-utils

# Faz o build falhar se qualquer parte de um pipe falhar
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Instala o opencode
RUN curl -fsSL https://opencode.ai/install | bash

ENV PATH="/root/.opencode/bin:${PATH}"

# Valida a instalação (o build quebra aqui se o binário não existir ou não executar)
RUN opencode --version

WORKDIR /contents

CMD ["opencode"]
